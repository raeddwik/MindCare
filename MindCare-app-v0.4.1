/* MindCare v0.4.1 - Supabase backed client + protected Admin */
const app=document.getElementById('app');
let db={therapists:[],services:[],availability:[],bookings:[]};
let booking={serviceId:null,therapistId:null,duration:null,date:null,time:null};
let currentUser=null,isAdmin=false;
const sb=window.mindcareSupabase;

function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
function go(p){location.hash=p}
function render(c){app.innerHTML=`<div class="container">${c}<div class="footer">MindCare PWA — v0.4.1</div></div>`}
function money(v){return `${Number(v||0).toLocaleString('ar-EG')} EGP`}
function formatDate(d){return new Date(d+'T00:00:00').toLocaleDateString('ar-EG',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}
function mins(t){let[a,b]=String(t).slice(0,5).split(':').map(Number);return a*60+b}
function addM(t,n){let v=mins(t)+n;return String(Math.floor(v/60)).padStart(2,'0')+':'+String(v%60).padStart(2,'0')}
function steps(a){return `<div class="step">${['الخدمة','الأخصائي','المدة','التاريخ','الوقت','البيانات'].map((x,i)=>`<span class="${i===a?'active':''}">${i+1}. ${x}</span>`).join('')}</div>`}
function therapist(){return db.therapists.find(x=>x.id===booking.therapistId)||db.therapists[0]}
function service(){return db.services.find(x=>x.id===booking.serviceId)||db.services[0]}
function therapistBy(id){return db.therapists.find(x=>x.id===id)||{name:'—'}}
function serviceBy(id){return db.services.find(x=>x.id===id)||{name:'—'}}

async function loadData(){
 if(!sb)throw Error('Supabase client غير موجود.');
 const [t,s,a]=await Promise.all([
  sb.from('therapists').select('*').eq('active',true).order('name'),
  sb.from('services').select('*').eq('active',true).order('duration_minutes'),
  sb.from('availability').select('*').eq('active',true).order('available_date').order('start_time')
 ]);
 if(t.error)throw t.error;if(s.error)throw s.error;if(a.error)throw a.error;
 db.therapists=(t.data||[]).map(x=>({...x,role:x.specialty||'',initials:(x.name||'م').replace(/^د\.\s*/,'').trim().charAt(0)||'م'}));
 db.services=s.data||[];db.availability=a.data||[];
}
function home(){render(`<section class="hero"><span class="badge">MindCare</span><h1>رعايتك النفسية تبدأ بخطوة</h1><p>اختر الخدمة والأخصائي والموعد المناسب لك بسهولة.</p><button class="btn" onclick="go('book')">احجز جلسة جديدة</button></section><section class="section"><h2>خدماتنا</h2><div class="grid">${db.services.map(s=>`<div class="card"><h3>${esc(s.name)}</h3><p>${esc(s.description||'')}</p><div class="price">${money(s.price)}</div></div>`).join('')}</div></section>`)}
function book(){render(`${steps(0)}<h2>اختر نوع الخدمة</h2><div class="grid">${db.services.map(s=>`<div class="card"><h3>${esc(s.name)}</h3><p>${esc(s.description||'')}</p><div class="price">${money(s.price)}</div><button class="btn" onclick="selectService('${s.id}')">اختيار</button></div>`).join('')}</div><button class="btn secondary" onclick="go('home')">رجوع</button>`)}
function selectService(id){let s=db.services.find(x=>x.id===id);if(!s)return;booking={serviceId:id,therapistId:null,duration:Number(s.duration_minutes),date:null,time:null};chooseTherapist()}
function chooseTherapist(){render(`${steps(1)}<h2>اختر الأخصائي</h2><div class="grid">${db.therapists.map(t=>`<div class="card"><div class="doctor"><div class="avatar">${esc(t.initials)}</div><div><h3>${esc(t.name)}</h3><div>${esc(t.role)}</div></div></div><p>${esc(t.bio||'')}</p><button class="btn" onclick="selectTherapist('${t.id}')">اختيار</button></div>`).join('')}</div><button class="btn secondary" onclick="book()">رجوع</button>`)}
function selectTherapist(id){booking.therapistId=id;chooseDuration()}
function chooseDuration(){let s=service();render(`${steps(2)}<h2>مدة الجلسة</h2><div class="grid"><div class="card"><h3>${Number(s.duration_minutes)} دقيقة</h3><div class="price">${money(s.price)}</div><button class="btn" onclick="selectDuration(${Number(s.duration_minutes)})">اختيار</button></div></div><button class="btn secondary" onclick="chooseTherapist()">رجوع</button>`)}
function selectDuration(d){booking.duration=Number(d);chooseDate()}
function datesForTherapist(){return [...new Set(db.availability.filter(a=>a.therapist_id===booking.therapistId&&a.available_date).map(a=>a.available_date))].sort()}
function chooseDate(){let ds=datesForTherapist();render(`${steps(3)}<h2>اختر التاريخ</h2>${ds.length?`<div class="grid">${ds.map(d=>`<div class="card"><h3>${formatDate(d)}</h3><p>${esc(therapist()?.name||'')} — ${booking.duration} دقيقة</p><button class="btn" onclick="chooseTime('${d}')">عرض المواعيد</button></div>`).join('')}</div>`:'<div class="notice">لا توجد مواعيد متاحة لهذا الأخصائي حاليًا.</div>'}<button class="btn secondary" onclick="chooseDuration()">رجوع</button>`)}
function slots(date){let out=[];for(let a of db.availability.filter(x=>x.therapist_id===booking.therapistId&&x.available_date===date)){let t=String(a.start_time).slice(0,5),e=String(a.end_time).slice(0,5);while(mins(t)<mins(e)){out.push(t);t=addM(t,30)}}return [...new Set(out)].sort()}
async function available(date,duration){let {data,error}=await sb.from('appointments').select('start_at,end_at').eq('therapist_id',booking.therapistId).gte('start_at',`${date}T00:00:00+03:00`).lte('start_at',`${date}T23:59:59+03:00`).in('status',['pending','confirmed']);if(error)throw error;let bs=data||[];return slots(date).filter(t=>{let end=addM(t,duration);let inside=db.availability.some(a=>a.therapist_id===booking.therapistId&&a.available_date===date&&mins(t)>=mins(a.start_time)&&mins(end)<=mins(a.end_time));if(!inside)return false;let ds=new Date(`${date}T${t}:00+03:00`).getTime(),de=new Date(`${date}T${end}:00+03:00`).getTime();return !bs.some(b=>ds<new Date(b.end_at).getTime()&&new Date(b.start_at).getTime()<de)})}
async function chooseTime(date){booking.date=date;render(`${steps(4)}<h2>اختر الوقت</h2><p>${formatDate(date)} — ${esc(therapist()?.name||'')}</p><div class="notice">جارٍ تحميل المواعيد...</div>`);try{let av=await available(date,booking.duration),ss=slots(date);render(`${steps(4)}<h2>اختر الوقت</h2><p>${formatDate(date)} — ${esc(therapist()?.name||'')}</p><div class="slots">${ss.map(t=>`<button class="slot ${av.includes(t)?'':'busy'}" ${av.includes(t)?`onclick="clientData('${t}')"`:'disabled'}>${t}</button>`).join('')}</div>${av.length?'':'<div class="notice">لا توجد أوقات متاحة لهذه المدة.</div>'}<button class="btn secondary" onclick="chooseDate()">رجوع</button>`)}catch(e){render(`<div class="notice warning">تعذر تحميل المواعيد: ${esc(e.message)}</div><button class="btn" onclick="chooseTime('${date}')">إعادة المحاولة</button>`)}}
function clientData(time){booking.time=time;let s=service();render(`${steps(5)}<h2>بيانات الحجز</h2><div class="card form"><input id="clientName" class="input" placeholder="الاسم الكامل" autocomplete="name"><input id="clientPhone" class="input" placeholder="رقم الهاتف" inputmode="tel" autocomplete="tel"><input id="clientEmail" class="input" placeholder="البريد الإلكتروني (اختياري)" type="email" autocomplete="email"><label><input type="checkbox" id="consent"> أوافق على سياسة الخصوصية وشروط الحجز.</label><div class="notice summary"><b>ملخص الحجز</b><br>${esc(s.name)}<br>${esc(therapist().name)}<br>${booking.duration} دقيقة — ${formatDate(booking.date)} — ${booking.time}<br><b>${money(s.price)}</b></div><button class="btn" onclick="confirmBooking()">تأكيد الحجز</button><button class="btn secondary" onclick="chooseTime('${booking.date}')">رجوع</button></div>`)}
async function confirmBooking(){let name=document.getElementById('clientName').value.trim(),phone=document.getElementById('clientPhone').value.trim(),email=document.getElementById('clientEmail').value.trim(),consent=document.getElementById('consent').checked;if(!name||!phone||!consent){alert('يرجى إدخال الاسم ورقم الهاتف والموافقة على الشروط.');return}try{if(!(await available(booking.date,booking.duration)).includes(booking.time)){alert('هذا الموعد لم يعد متاحًا.');return chooseTime(booking.date)}let s=service(),t=therapist(),start=`${booking.date}T${booking.time}:00+03:00`,end=`${booking.date}T${addM(booking.time,booking.duration)}:00+03:00`;let {data,error}=await sb.from('appointments').insert({client_name:name,client_phone:phone,client_email:email||null,therapist_id:t.id,service_id:s.id,start_at:start,end_at:end,duration_minutes:booking.duration,price:Number(s.price),consent_given:true,status:'pending'}).select('booking_code,status').single();if(error)throw error;try{let old=JSON.parse(localStorage.getItem('mindcare_v4_mybookings')||'[]');old.unshift({booking_code:data.booking_code,name,phone,email,serviceId:s.id,therapistId:t.id,duration:booking.duration,date:booking.date,time:booking.time,price:s.price,status:data.status});localStorage.setItem('mindcare_v4_mybookings',JSON.stringify(old))}catch(_){}render(`<section class="hero"><h2>✓ تم حجز موعدك بنجاح</h2><p>${esc(s.name)}<br>${esc(t.name)}<br>${formatDate(booking.date)} — ${booking.time}<br>جلسة ${booking.duration} دقيقة</p><p>رقم الحجز: <b>${esc(data.booking_code)}</b></p><p>حالة الحجز: <b>${esc(data.status)}</b></p><button class="btn" onclick="go('appointments')">مواعيدي</button><button class="btn secondary" onclick="go('home')">الرئيسية</button></section>`)}catch(e){alert('تعذر إتمام الحجز: '+(e.message||'خطأ غير معروف'))}}
function appointments(){let rows=[];try{rows=JSON.parse(localStorage.getItem('mindcare_v4_mybookings')||'[]')}catch(_){}render(`<h2>مواعيدي</h2>${rows.length?`<div class="grid">${rows.map(b=>`<div class="card"><h3>${formatDate(b.date)} — ${esc(b.time)}</h3><p>${esc(serviceBy(b.serviceId).name)}<br>${esc(therapistBy(b.therapistId).name)}<br>${b.duration} دقيقة — ${money(b.price)}</p><span class="badge">${esc(b.status)}</span><p class="muted">رقم الحجز: ${esc(b.booking_code)}</p></div>`).join('')}</div>`:'<div class="card">لا توجد حجوزات محفوظة على هذا الجهاز.</div>'}`)}

async function checkAdmin(){if(!currentUser)return false;let {data,error}=await sb.from('user_roles').select('role').eq('user_id',currentUser.id).eq('role','admin').maybeSingle();if(error)throw error;isAdmin=!!data;return isAdmin}
function adminLogin(msg=''){render(`<section class="hero"><span class="badge">MindCare Admin</span><h2>تسجيل دخول الإدارة</h2><p>هذه المنطقة مخصصة للمستخدمين المصرح لهم فقط.</p></section><div class="card form">${msg?`<div class="notice warning">${esc(msg)}</div>`:''}<input id="adminEmail" class="input" type="email" placeholder="البريد الإلكتروني" autocomplete="username"><input id="adminPassword" class="input" type="password" placeholder="كلمة المرور" autocomplete="current-password"><button class="btn" onclick="adminLoginSubmit()">تسجيل الدخول</button><button class="btn secondary" onclick="go('home')">رجوع</button></div>`)}
async function adminLoginSubmit(){let email=document.getElementById('adminEmail').value.trim(),password=document.getElementById('adminPassword').value;if(!email||!password)return adminLogin('يرجى إدخال البريد الإلكتروني وكلمة المرور.');let {data,error}=await sb.auth.signInWithPassword({email,password});if(error)return adminLogin('بيانات الدخول غير صحيحة أو تعذر تسجيل الدخول.');currentUser=data.user;try{if(!(await checkAdmin())){await sb.auth.signOut();currentUser=null;return adminLogin('الحساب لا يملك صلاحية Admin.')}}catch(e){await sb.auth.signOut();return adminLogin('تعذر التحقق من صلاحيات الحساب.')}adminDashboard()}
async function adminLogout(){await sb.auth.signOut();currentUser=null;isAdmin=false;go('home')}
async function admin(){try{let {data}=await sb.auth.getSession();currentUser=data.session?.user||null;if(!currentUser)return adminLogin();if(!(await checkAdmin()))return render(`<section class="hero"><h2>غير مصرح بالدخول</h2><p>هذا الحساب لا يملك صلاحية الإدارة.</p><button class="btn secondary" onclick="adminLogout()">تسجيل الخروج</button></section>`);await adminDashboard()}catch(e){render(`<div class="notice warning">تعذر التحقق من الإدارة: ${esc(e.message)}</div><button class="btn" onclick="adminLogin()">إعادة المحاولة</button>`)} }
async function adminDashboard(){render('<div class="notice">جارٍ تحميل لوحة الإدارة...</div>');let [a,t,s]=await Promise.all([sb.from('appointments').select('id,booking_code,client_name,client_phone,client_email,therapist_id,service_id,start_at,duration_minutes,price,status,created_at').order('start_at',{ascending:false}),sb.from('therapists').select('*').order('name'),sb.from('services').select('*').order('duration_minutes')]);if(a.error)throw a.error;if(t.error)throw t.error;if(s.error)throw s.error;db.bookings=a.data||[];db.therapists=(t.data||[]).map(x=>({...x,role:x.specialty||'',initials:(x.name||'م').charAt(0)}));db.services=s.data||[];render(`<div class="card"><span class="badge">Admin</span><h2>لوحة الإدارة</h2><p class="muted">${esc(currentUser.email)}</p><button class="btn secondary" onclick="adminLogout()">تسجيل الخروج</button></div><div class="grid"><div class="card"><h3>إجمالي الحجوزات</h3><div class="price">${db.bookings.length}</div></div><div class="card"><h3>قيد الانتظار</h3><div class="price">${db.bookings.filter(x=>x.status==='pending').length}</div></div><div class="card"><h3>مؤكدة</h3><div class="price">${db.bookings.filter(x=>x.status==='confirmed').length}</div></div></div><h2>الحجوزات</h2><div class="card"><input id="bookingSearch" class="input" placeholder="ابحث برقم الحجز أو اسم العميل أو الهاتف" oninput="filterBookings()"></div><div id="adminBookings" class="table-wrapper">${bookingTable(db.bookings)}</div><h2>الأخصائيون</h2><div class="grid">${db.therapists.map(x=>`<div class="card"><h3>${esc(x.name)}</h3><p>${esc(x.role)}</p><span class="badge">${x.active?'نشط':'غير نشط'}</span></div>`).join('')}</div><h2>الخدمات والأسعار</h2><div class="grid">${db.services.map(x=>`<div class="card"><h3>${esc(x.name)}</h3><p>${x.duration_minutes} دقيقة</p><div class="price">${money(x.price)}</div><span class="badge">${x.active?'نشطة':'غير نشطة'}</span></div>`).join('')}</div>`)}
function bookingTable(rows){if(!rows.length)return '<div class="notice">لا توجد حجوزات.</div>';return `<table class="table"><tr><th>رقم الحجز</th><th>العميل</th><th>الأخصائي</th><th>الموعد</th><th>الخدمة</th><th>الحالة</th><th>إجراء</th></tr>${rows.map(b=>`<tr><td>${esc(b.booking_code)}</td><td>${esc(b.client_name)}<br>${esc(b.client_phone)}</td><td>${esc(therapistBy(b.therapist_id).name)}</td><td>${esc(new Date(b.start_at).toLocaleString('ar-EG'))}</td><td>${esc(serviceBy(b.service_id).name)}</td><td>${esc(b.status)}</td><td><select class="select" onchange="updateStatus('${b.id}',this.value)">${['pending','confirmed','completed','cancelled','no_show'].map(x=>`<option value="${x}" ${b.status===x?'selected':''}>${x}</option>`).join('')}</select></td></tr>`).join('')}</table>`}
function filterBookings(){let q=(document.getElementById('bookingSearch')?.value||'').toLowerCase();document.getElementById('adminBookings').innerHTML=bookingTable(db.bookings.filter(b=>[b.booking_code,b.client_name,b.client_phone,b.client_email].some(v=>String(v||'').toLowerCase().includes(q))))}
async function updateStatus(id,status){let {error}=await sb.from('appointments').update({status}).eq('id',id);if(error){alert(error.message);return}let b=db.bookings.find(x=>x.id===id);if(b)b.status=status;filterBookings()}
async function route(){let p=location.hash.replace('#','')||'home';try{if(!db.services.length)await loadData();if(p==='admin')return admin();if(p==='book')return book();if(p==='appointments')return appointments();home()}catch(e){render(`<div class="notice warning">تعذر الاتصال بقاعدة البيانات: ${esc(e.message)}</div>`)} }
addEventListener('hashchange',route);(async()=>{if(sb){let {data}=await sb.auth.getSession();currentUser=data.session?.user||null;sb.auth.onAuthStateChange((_e,session)=>currentUser=session?.user||null)}await route();if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js').catch(console.error)})();
